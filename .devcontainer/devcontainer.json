{
  "name": "OpenLinkToken-Truveta-Extension",
  "dockerComposeFile": ["docker-compose.yml", "docker-compose.worktree.yml"],
  "service": "app",
  "workspaceFolder": "/workspaces/OpenLinkToken-Truveta-Extension",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "configureZshAsDefaultShell": true
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    },
    "ghcr.io/devcontainers/features/copilot-cli:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11",
      "installPipenv": "true"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "streetsidesoftware.code-spell-checker",
        "esbenp.prettier-vscode",
        "DavidAnson.vscode-markdownlint",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.flake8",
        "charliermarsh.ruff",
        "ms-azuretools.vscode-docker",
        "yzhang.markdown-all-in-one",
        "AdamViola.parquet-explorer",
        "GitHub.vscode-pull-request-github",
        "GitHub.vscode-github-actions",
        "GitHub.copilot-chat",
        "ms-python.python",
        "dbaeumer.vscode-eslint",
        "ms-python.debugpy"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/home/vscode/.local/share/openlinktoken-ext-truveta/.venv/bin/python"
      }
    }
  },
  "mounts": [
    "type=volume,source=openlinktoken-ext-truveta-local,target=/home/vscode/.local",
    "type=volume,source=openlinktoken-ext-truveta-cache,target=/home/vscode/.cache",
    "type=volume,source=openlinktoken-ext-truveta-copilot,target=/home/vscode/.copilot",
    "type=volume,source=openlinktoken-ext-truveta-vscode-server,target=/home/vscode/.vscode-server",
    "type=volume,source=openlinktoken-ext-truveta-vscode-insiders,target=/home/vscode/.vscode-server-insiders"
  ],
  "updateContentCommand": {
    "fix-mount-permissions": "for d in /home/vscode/.copilot /home/vscode/.cache /home/vscode/.local /home/vscode/.vscode-server /home/vscode/.vscode-server-insiders; do [ -d \"$d\" ] || continue; sudo chown -R vscode:vscode \"$d\"; done"
  },
  "initializeCommand": "bash -lc '${localWorkspaceFolder}/.devcontainer/scripts/prepare-worktree-mount.sh'",
  "postCreateCommand": "bash -lc '${containerWorkspaceFolder}/.devcontainer/scripts/unified-setup.sh post-create'",
  "postStartCommand": "bash -lc '${containerWorkspaceFolder}/.devcontainer/scripts/unified-setup.sh post-start'",
  "postAttachCommand": "bash -lc '${containerWorkspaceFolder}/.devcontainer/scripts/unified-setup.sh post-attach'",
  "remoteUser": "vscode"
}
